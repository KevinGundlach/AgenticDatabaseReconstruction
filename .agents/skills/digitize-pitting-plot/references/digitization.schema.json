{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-database-reconstruction:digitize-pitting-plot:v2",
  "title": "Digitized pitting-potential plot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_reference",
    "source_chart_manifest",
    "plot_metadata",
    "digitization_status",
    "digitization_notes",
    "plot_data"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "paper_reference": {"$ref": "#/$defs/nonEmptyString"},
    "source_chart_manifest": {"$ref": "#/$defs/nonEmptyString"},
    "plot_metadata": {"$ref": "#/$defs/plotMetadata"},
    "digitization_status": {
      "enum": ["unprocessed", "complete", "partial", "needs_review", "skipped"]
    },
    "digitization_notes": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "plot_data": {
      "type": "array",
      "items": {"$ref": "#/$defs/series"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"digitization_status": {"const": "complete"}}},
      "then": {"properties": {"plot_data": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"digitization_status": {"const": "partial"}}},
      "then": {
        "properties": {
          "digitization_notes": {"minItems": 1},
          "plot_data": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "digitization_status": {"enum": ["needs_review", "skipped"]}
        }
      },
      "then": {
        "properties": {
          "digitization_notes": {"minItems": 1},
          "plot_data": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"digitization_status": {"const": "unprocessed"}}},
      "then": {"properties": {"plot_data": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "classifierAxis": {
      "type": "object",
      "required": ["label", "unit", "scale"],
      "properties": {
        "label": {"type": "string"},
        "unit": {"type": "string"},
        "scale": {"enum": ["linear", "log", "categorical", "unknown"]}
      }
    },
    "plotMetadata": {
      "type": "object",
      "required": [
        "chart_id",
        "image_path",
        "caption",
        "reason_code",
        "reason",
        "confidence",
        "relevant_panels",
        "target_series",
        "x_axis",
        "y_axis"
      ],
      "properties": {
        "chart_id": {"$ref": "#/$defs/nonEmptyString"},
        "image_path": {"type": "string"},
        "caption": {"type": "string"},
        "reason_code": {"const": "direct_pitting_potential_plot"},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "relevant_panels": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "target_series": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "x_axis": {"$ref": "#/$defs/classifierAxis"},
        "y_axis": {"$ref": "#/$defs/classifierAxis"}
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "value": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "type", "unit", "is_target"],
      "properties": {
        "label": {"type": "string"},
        "type": {"enum": ["numeric", "categorical", "mixed"]},
        "unit": {"type": "string"},
        "scale": {"enum": ["linear", "log", "categorical", "unknown"]},
        "is_target": {"type": "boolean"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": ["number", "string", "null"]},
        "y": {"type": ["number", "string", "null"]},
        "x_lower": {"type": "number"},
        "x_upper": {"type": "number"},
        "x_interval_meaning": {"$ref": "#/$defs/nonEmptyString"},
        "y_lower": {"type": "number"},
        "y_upper": {"type": "number"},
        "y_interval_meaning": {"$ref": "#/$defs/nonEmptyString"},
        "label": {"type": ["string", "null"]}
      },
      "dependentRequired": {
        "x_lower": ["x_upper", "x_interval_meaning"],
        "x_upper": ["x_lower", "x_interval_meaning"],
        "x_interval_meaning": ["x_lower", "x_upper"],
        "y_lower": ["y_upper", "y_interval_meaning"],
        "y_upper": ["y_lower", "y_interval_meaning"],
        "y_interval_meaning": ["y_lower", "y_upper"]
      },
      "allOf": [
        {
          "if": {"properties": {"x": {"type": "null"}}},
          "then": {"required": ["x_lower", "x_upper", "x_interval_meaning"]}
        },
        {
          "if": {"properties": {"y": {"type": "null"}}},
          "then": {"required": ["y_lower", "y_upper", "y_interval_meaning"]}
        }
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "tags", "x_axis", "y_axis", "data_points"],
      "properties": {
        "series_id": {"$ref": "#/$defs/nonEmptyString"},
        "panel": {"type": ["string", "null"]},
        "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}},
        "x_axis": {"$ref": "#/$defs/axis"},
        "y_axis": {"$ref": "#/$defs/axis"},
        "data_points": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/point"}
        }
      }
    }
  }
}
