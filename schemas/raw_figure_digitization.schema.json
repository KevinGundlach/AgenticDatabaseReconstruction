{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw figure digitization",
  "description": "Model-facing raw observations. Normalized or converted values are prohibited.",
  "type": "object",
  "required": ["schema_version", "paper_id", "figure_id", "source_image", "caption", "x_axis", "y_axis", "series"],
  "properties": {
    "schema_version": {"const": 1},
    "paper_id": {"type": ["string", "integer"]},
    "figure_id": {"type": ["string", "integer"]},
    "source_image": {"type": "string"},
    "caption": {"type": "string"},
    "x_axis": {"$ref": "#/$defs/axis"},
    "y_axis": {"$ref": "#/$defs/axis"},
    "composition_context": {
      "type": "object",
      "required": ["base_element", "solute_element"],
      "properties": {
        "base_element": {"type": "string"},
        "solute_element": {"type": "string"}
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "plot_box": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "x": {"$ref": "#/$defs/calibrationPair"},
        "y": {"$ref": "#/$defs/calibrationPair"}
      },
      "additionalProperties": false
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/series"}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "axis": {
      "type": "object",
      "required": ["label", "unit", "scale"],
      "properties": {
        "label": {"type": "string"},
        "unit": {"type": "string"},
        "reference": {"type": "string"},
        "reference_vs_she_mv": {"type": "number"},
        "scale": {"enum": ["linear", "log10", "ln"]}
      },
      "additionalProperties": false
    },
    "calibrationPoint": {
      "type": "object",
      "required": ["pixel", "value"],
      "properties": {
        "pixel": {"type": "number"},
        "value": {"type": "number"}
      },
      "additionalProperties": false
    },
    "calibrationPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/calibrationPoint"}
    },
    "point": {
      "type": "object",
      "required": ["x", "y", "confidence"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "pixel_x": {"type": "number"},
        "pixel_y": {"type": "number"},
        "uncertainty_x": {"type": "number", "minimum": 0},
        "uncertainty_y": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": ["series_id", "label", "metric", "points"],
      "properties": {
        "series_id": {"type": "string"},
        "label": {"type": "string"},
        "metric": {"enum": ["pitting_potential", "repassivation_potential", "corrosion_potential", "current_density", "other"]},
        "sample_condition": {"type": "string"},
        "marker_type": {"type": "string"},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}}
      },
      "additionalProperties": false
    }
  }
}

